# Copy this file to .env and fill in your own keys. .env is gitignored. Never commit real keys.

# --- LLM provider and key -------------------------------------------------
# No API key variable is read by the current Phase 2 stubs. When the real LLM
# lands, only ONE key is required: GEMINI_API_KEY (free key from Google AI
# Studio, https://aistudio.google.com/app/apikey) OR GROQ_API_KEY (free key
# from console.groq.com, https://console.groq.com/keys). Never commit either.

# --- Model name -----------------------------------------------------------
# LLM_MODEL: model id read by src/settings_p2.py via os.getenv; optional,
# default "gemini-1.5-flash"; pick a model from Google AI Studio or Groq, and
# only one provider key is required.
LLM_MODEL=your_model_name_here

# --- Data path ------------------------------------------------------------
# RESEARCH_PAPERS_PATH: optional path to the cleaned papers.parquet read by
# notebooks/03_preprocessing.ipynb via os.environ; no default (it falls back
# to the Kaggle mount, then data/papers.parquet); no API key needed.
RESEARCH_PAPERS_PATH=your_papers_parquet_path_here
